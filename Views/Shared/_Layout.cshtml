@inject GtrackWeb.Services.CurrentUser CurrentUser
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var authed = User.Identity?.IsAuthenticated ?? false;
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@tokens.RequestToken" />
    <title>@ViewData["Title"] - Gtrack</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (authed && CurrentUser.CompanySelected)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Gtrack</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @foreach (var group in GtrackWeb.Services.MenuProvider.Build())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">@group.Title</a>
                                <ul class="dropdown-menu">
                                    @foreach (var item in group.Items)
                                    {
                                        <li>
                                            @if (item.Enabled && item.Controller != null)
                                            {
                                                <a class="dropdown-item" asp-controller="@item.Controller" asp-action="@item.Action">@item.Text</a>
                                            }
                                            else
                                            {
                                                <span class="dropdown-item disabled text-muted" title="Not yet ported (Phase 2)">@item.Text</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <span class="navbar-text text-light me-3">
                        <strong>@CurrentUser.CompName</strong> &middot; @CurrentUser.Year &middot; @CurrentUser.UserName
                    </span>
                    <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="ChangePassword">Change Password</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning">Logout</button>
                    </form>
                </div>
            </div>
        </nav>
    }

    <main class="container-fluid py-3">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show">@msg<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
