@{
    ViewData["Title"] = "Mail Id";
    var rows = (List<MailRow>)ViewData["Rows"]!;
}
<h3 class="mb-3">Employee Mail Id</h3>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Add Mail Id</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Employee Code</label>
                        <input name="empCode" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Mail Id</label>
                        <input name="mailId" type="email" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <table class="table table-striped table-bordered">
            <thead class="table-dark"><tr><th>Company</th><th>Emp Code</th><th>Mail Id</th><th style="width:90px"></th></tr></thead>
            <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@r.CompName</td>
                    <td>@r.EmpCode</td>
                    <td>@r.MailId</td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this mail id?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="empCode" value="@r.EmpCode" />
                            <input type="hidden" name="mailId" value="@r.MailId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">No mail ids yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
