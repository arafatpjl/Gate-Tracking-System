@{
    ViewData["Title"] = "Driver";
    var rows = (List<DriverRow>)ViewData["Rows"]!;
}
<h3 class="mb-3">Driver</h3>
<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Add Driver</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Driver Name</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Licence No</label>
                        <input name="licence" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <table class="table table-striped table-bordered">
            <thead class="table-dark"><tr><th>Name</th><th>Licence</th><th style="width:120px">Action</th></tr></thead>
            <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td colspan="2">
                        <form asp-action="Update" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="did" value="@r.Did" />
                            <div class="col"><input name="name" value="@r.Name" class="form-control form-control-sm" /></div>
                            <div class="col"><input name="licence" value="@r.Licence" class="form-control form-control-sm" /></div>
                            <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Update</button></div>
                        </form>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this driver?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="did" value="@r.Did" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted">No drivers yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
