@{
    ViewData["Title"] = "Challans";
    var rows = (List<ChallanListRow>)ViewData["Rows"]!;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Challans</h3>
    <a asp-action="Sender" class="btn btn-primary">+ New Challan Sender</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr><th>GP No</th><th>Date</th><th>Group</th><th style="width:80px"></th></tr>
    </thead>
    <tbody>
    @foreach (var r in rows)
    {
        <tr>
            <td>@r.GpNo</td><td>@r.GpDate</td><td>@r.GroupName</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-gpNo="@r.GpNo">Edit</a></td>
        </tr>
    }
    @if (rows.Count == 0)
    {
        <tr><td colspan="4" class="text-center text-muted">No challans yet.</td></tr>
    }
    </tbody>
</table>
