@using GtrackWeb.Services
@{
    ViewData["Title"] = "Home";
    var menu = (IReadOnlyList<MenuGroup>)ViewData["Menu"]!;
}
<h3 class="mb-4">Dashboard</h3>
<div class="row g-3">
    @foreach (var group in menu)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">@group.Title</div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in group.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @if (item.Enabled && item.Controller != null)
                            {
                                <a asp-controller="@item.Controller" asp-action="@item.Action">@item.Text</a>
                                <span class="badge bg-success">Ready</span>
                            }
                            else
                            {
                                <span class="text-muted">@item.Text</span>
                                <span class="badge bg-secondary">Phase 2</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
