@{
    ViewData["Title"] = "Item";
    var rows = (List<ItemRow>)ViewData["Rows"]!;
    var groups = (List<ItemGroupRow>)ViewData["Groups"]!;
}
<h3 class="mb-3">Item</h3>
<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Add Item</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Item Name</label>
                        <input name="itemName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Item Group</label>
                        <select name="itemType" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var g in groups)
                            {
                                <option value="@g.ItemType">@g.ItemType</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <table class="table table-striped table-bordered">
            <thead class="table-dark"><tr><th>Item</th><th>Group</th><th style="width:120px">Action</th></tr></thead>
            <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td colspan="2">
                        <form asp-action="Update" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@r.ItemId" />
                            <div class="col"><input name="itemName" value="@r.ItemName" class="form-control form-control-sm" /></div>
                            <div class="col">
                                <select name="itemType" class="form-select form-select-sm">
                                    @foreach (var g in groups)
                                    {
                                        if (g.ItemType == r.ItemType)
                                        {
                                            <option value="@g.ItemType" selected>@g.ItemType</option>
                                        }
                                        else
                                        {
                                            <option value="@g.ItemType">@g.ItemType</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Update</button></div>
                        </form>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this item?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@r.ItemId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted">No items yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
