@{
    ViewData["Title"] = "Item Group";
    var rows = (List<ItemGroupRow>)ViewData["Rows"]!;
}
<h3 class="mb-3">Item Group</h3>
<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Add Item Group</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Item Group Name</label>
                        <input name="itemType" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <table class="table table-striped table-bordered">
            <thead class="table-dark"><tr><th>Item Group</th><th style="width:260px">Action</th></tr></thead>
            <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <input name="itemType" value="@r.ItemType" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this item group?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="2" class="text-center text-muted">No item groups yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
